# Copy to .env on the server, fill in, then: chmod 600 .env

# Port assigned to netlab.dcism.org (Apache proxies to it). Listen on localhost only.
PORT=
HOST=127.0.0.1
NODE_ENV=production

# Postgres database and user made for this project only.
DATABASE_URL=postgres://netlab_app:CHANGE_ME@127.0.0.1:5432/netlab

# Only these email domains can register (comma-separated), e.g. your school's domain.
ALLOWED_EMAIL_DOMAIN=
