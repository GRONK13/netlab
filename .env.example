# Copy to .env on the server, fill in, then: chmod 600 .env

# Port assigned to netlab.dcism.org (Apache proxies to it). Listen on localhost only.
PORT=
HOST=127.0.0.1
NODE_ENV=production

# Postgres database and user made for this project only.
DATABASE_URL=postgres://netlab_app:CHANGE_ME@127.0.0.1:5432/netlab

# Where the site is served; sign-in providers redirect back here.
PUBLIC_URL=https://netlab.dcism.org

# Sign in with Google and GitHub (see "Sign in with Google and GitHub" in README.md).
# Each provider is offered only when both its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email-and-password sign-up closes once a provider is set; EMAIL_SIGNUP=1 or 0 overrides.
# EMAIL_SIGNUP=
# While email sign-up is open, only these domains can use it (comma-separated). Empty = any.
ALLOWED_EMAIL_DOMAIN=
# The school's email domain, for the leaderboard's "USC only" filter.
SCHOOL_DOMAIN=usc.edu.ph
